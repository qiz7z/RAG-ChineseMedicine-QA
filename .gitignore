# Processed data (regenerate via: python scripts/run/run_etl.py)
# data/processed/

# Vector store indices (regenerate via: python scripts/build/build_index.py)
# data/vectorstore/

# Model weights (download from HuggingFace)
# 模型权重（行尾注释会把规则写坏：gitignore 不支持行尾 # 注释）
models/**/model.safetensors
# bge-reranker-v2-m3 是可选组件（默认关重排），整体不入库
models/bge-reranker-v2-m3/
models/bge-large-zh-v1.5/model.safetensors
models/bge-large-zh-v1.5/*.bin

# Evaluation reports —— **入库**（审计链：README/docs 里每个数字都应能在 reports/ 里找到来源；
# 且 docs/04、docs/05 直接引用了具体报告文件名，不入库会变成死链）
# 如需停止入库，取消下面一行注释：
# data/eval/reports/

# Logs
*.log
build_index.log

# Environment
.env
.env.local

